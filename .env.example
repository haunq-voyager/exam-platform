# Copy to .env (same folder as docker-compose.yml) to configure secrets used
# by `docker compose up`. This file is read by Docker Compose for variable
# interpolation — it is separate from backend/.env.

# Google Gemini API key (free tier) — get one at https://aistudio.google.com/apikey
# Leave empty to keep the backend running on the deterministic mock AI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
