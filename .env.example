# Copy to .env (same folder as docker-compose.yml) to configure secrets used
# by `docker compose up`. This file is read by Docker Compose for variable
# interpolation — it is separate from backend/.env.

# Anthropic Claude API key (preferred if set) — from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini API key (used only if ANTHROPIC_API_KEY is empty) — free tier,
# get one at https://aistudio.google.com/apikey.
# Leave both empty to keep the backend running on the deterministic mock AI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
